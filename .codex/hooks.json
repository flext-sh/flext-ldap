          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 /home/marlonsc/flext/flext-ldap/.codex/aihub-hooks/codex-sessionstart.py",
