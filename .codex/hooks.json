    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 /home/marlonsc/flext/flext-ldap/.codex/aihub-hooks/codex-subagentstart.py",
            "statusMessage": "Applying synchronized governance",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 /home/marlonsc/flext/flext-ldap/.codex/aihub-hooks/codex-userpromptsubmit.py",
            "statusMessage": "Applying synchronized governance",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
